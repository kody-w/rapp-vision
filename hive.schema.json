{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kody-w.github.io/rapp-vision/hive.schema.json",
  "title": "RAPP Hive static federation object",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "visibility",
    "revision",
    "channels",
    "peers"
  ],
  "properties": {
    "schema": {
      "const": "rapp-hive/1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "visibility": {
      "enum": [
        "public",
        "private"
      ]
    },
    "revision": {
      "type": "object",
      "required": [
        "sequence",
        "updated"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "updated": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "repo": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "peers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "const": "pull"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
