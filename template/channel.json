{
  "schema": "rapp-vision-channel/2.0",
  "id": "my-channel",
  "name": "My Channel",
  "handle": "@your-github-handle",
  "tagline": "One line about what this channel is.",
  "avatar": "📺",
  "links": [
    {
      "label": "GitHub",
      "url": "https://github.com/your-github-handle"
    }
  ],
  "_howto": "Every new publication is one paired entry. MP4 and WebM provide the default guided video; live is the take-the-wheel replay available from the same permalink. Entry duration/chapters describe the film; live duration/chapters describe the replay and may differ. Every src, thumb, and app resolves relative to this file.",
  "videos": [
    {
      "id": "my-first-publication",
      "title": "My first paired publication",
      "description": "The guided video explains the work. The live replay lets the viewer interrupt it and take control.",
      "published": "2026-01-01",
      "duration": 30,
      "width": 1280,
      "height": 800,
      "orientation": "landscape",
      "tags": [
        "demo",
        "live-replay"
      ],
      "thumb": "thumbs/my-first-publication.jpg",
      "sources": [
        {
          "src": "media/my-first-publication.mp4",
          "type": "video/mp4; codecs=\"avc1.4D401F, mp4a.40.2\""
        },
        {
          "src": "media/my-first-publication.webm",
          "type": "video/webm; codecs=\"vp9, opus\""
        }
      ],
      "chapters": [
        {
          "t": 0,
          "label": "Orientation"
        },
        {
          "t": 6,
          "label": "Take the wheel"
        }
      ],
      "live": {
        "kind": "rapp-vision-live/1.0",
        "duration": 36,
        "chapters": [
          {
            "t": 0,
            "label": "Replay briefing"
          },
          {
            "t": 6,
            "label": "Drive the real app"
          }
        ],
        "scenes": [
          {
            "t": 0,
            "dur": 6,
            "card": {
              "title": "The proof is live",
              "sub": "This replay drives the real application.",
              "note": "Switch back to the guided video at any time."
            }
          },
          {
            "t": 6,
            "dur": 30,
            "app": "../my-app.html",
            "ready": {
              "selector": "#start-button"
            },
            "lower": {
              "title": "My App",
              "bench": "A visible benchmark",
              "fix": "Pause and take control"
            },
            "actions": [
              {
                "at": 1,
                "do": "click",
                "selector": "#start-button"
              },
              {
                "at": 4,
                "do": "keydown",
                "code": "KeyW"
              },
              {
                "at": 9,
                "do": "keyup",
                "code": "KeyW"
              },
              {
                "at": 12,
                "do": "drag",
                "from": [
                  400,
                  300
                ],
                "to": [
                  700,
                  420
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
